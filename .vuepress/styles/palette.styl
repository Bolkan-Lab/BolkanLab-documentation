/**
 * Custom palette here.
 *
 * ref：https://v1.vuepress.vuejs.org/zh/config/#palette-styl
 */

/*
 * The Bolkan Lab brand yellow is #fcd34d. Used directly as $accentColor it fails
 * WCAG AA contrast on a white background (~1.5:1), which makes links and the
 * hero button hard to read. $accentColor below is a darkened gold that keeps the
 * brand hue while passing AA (~4.5:1) for body-size text.
 *
 * To use the pure brand yellow instead, swap the line below for:
 *   $accentColor = #fcd34d
 */
$accentColor = #9a7000
$textColor = #2c3e50
$borderColor = #eaecef
$codeBgColor = #282c34
